@model IEnumerable<ĐACN.Models.DonHangListViewModel>

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_LayoutNhaHang.cshtml";
}

<div class="container mt-4">
    <h3 class="mb-3 text-primary">Danh sách đơn hàng</h3>

    <form method="get" action="@Url.Action("DanhSachDonHang", "NhaHang")" class="row mb-4">
        <div class="col-md-3">
            <label>Từ ngày</label>
            <input type="date" name="tuNgay" class="form-control" value="@ViewBag.TuNgay" />
        </div>
        <div class="col-md-3">
            <label>Đến ngày</label>
            <input type="date" name="denNgay" class="form-control" value="@ViewBag.DenNgay" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </form>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Shipper</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Không có đơn hàng nào</td>
                </tr>
            }
            else
            {
                foreach (var don in Model)
                {
                    <tr>
                        <td class="order-ma-don">@don.MaDon</td>
                        <td class="order-khach-hang">@don.TenKhachHang</td>
                        <td class="order-thoi-gian">@(don.ThoiGianDat?.ToString("dd/MM/yyyy HH:mm"))</td>
                        <td class="order-tong-tien">@string.Format("{0:N0} đ", don.TongTien)</td>
                        <td class="order-trang-thai">
                            <span class="badge @(don.TrangThai == "True" ? "bg-success" : (don.TrangThai == "Hoàn thành" ? "bg-success" : "bg-warning text-dark"))">
                                @(don.TrangThai == "True" ? "Hoàn tất" : (don.TrangThai == "Hoàn thành" ? "Hoàn thành" : (don.TrangThai ?? "Đang xử lý")))
                            </span>
                        </td>
                        <td class="order-shipper">@(don.TenShipper ?? "Chưa có")</td>
                        <td>
                            <a href="@Url.Action("ChiTietDonHang", "NhaHang", new { id = don.MaDon })"
                               class="btn btn-sm btn-info text-white">
                                Xem
                            </a>
                            @if (don.TrangThai != "True" && don.TrangThai != "Hoàn thành" && string.IsNullOrEmpty(don.TenShipper))
                            {
                                using (Html.BeginForm("CapNhatLamXong", "NhaHang", FormMethod.Post, new { @class = "d-inline", style = "margin-left: 5px;" }))
                                {
                                    <input type="hidden" name="maDon" value="@don.MaDon" />
                                    <button type="submit" class="btn btn-sm btn-success"
                                            onclick="return confirm('Xác nhận đơn hàng @don.MaDon đã làm xong và sẵn sàng cho shipper lấy?');">
                                        Làm xong
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {

        var refreshIntervalMs = 5000;
        var isRefreshing = false;
        var refreshIntervalId = null;

        function updateOrderList() {
            if (isRefreshing) return;
            isRefreshing = true;


            var tuNgay = $('input[name="tuNgay"]').val();
            var denNgay = $('input[name="denNgay"]').val();

            $.ajax({
                url: '@Url.Action("GetDanhSachDonHangUpdate", "NhaHang")',
                type: 'GET',
                data: {
                    tuNgay: tuNgay,
                    denNgay: denNgay
                },
                success: function (response) {
                    if (response.success && response.orders) {
                        var tbody = $('table tbody');


                        var hasChanges = false;


                        response.orders.forEach(function (order) {
                            var row = tbody.find('tr').filter(function () {
                                return $(this).find('.order-ma-don').text() === order.MaDon;
                            });

                            if (row.length > 0) {

                                var currentStatus = row.find('.order-trang-thai .badge').text().trim();
                                var newStatus = order.TrangThaiDisplay;

                                var currentShipper = row.find('.order-shipper').text().trim();
                                var newShipper = order.TenShipper || 'Chưa có';

                                if (currentStatus !== newStatus || currentShipper !== newShipper) {
                                    hasChanges = true;


                                    var badge = row.find('.order-trang-thai .badge');
                                    badge.removeClass('bg-success bg-warning text-dark');
                                    badge.addClass(order.TrangThaiClass);
                                    badge.text(newStatus);


                                    row.find('.order-shipper').text(newShipper);


                                    row.css('background-color', '#fff3cd');
                                    setTimeout(function () {
                                        row.css('background-color', '');
                                    }, 2000);
                                }
                            }
                        });


                        if (hasChanges) {
                            console.log('Đã cập nhật trạng thái đơn hàng');
                        }
                    }
                    isRefreshing = false;
                },
                error: function () {
                    isRefreshing = false;
                    console.error('Lỗi khi cập nhật danh sách đơn hàng');
                }
            });
        }


        refreshIntervalId = setInterval(updateOrderList, refreshIntervalMs);


        $(window).on('beforeunload', function () {
            if (refreshIntervalId !== null) {
                clearInterval(refreshIntervalId);
            }
        });
    });
</script>