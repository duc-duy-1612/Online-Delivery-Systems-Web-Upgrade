@{
    ViewBag.Title = "Cài đặt tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
                    @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h3 class="mb-4 fw-bold text-dark border-bottom pb-2">Cài đặt tài khoản</h3>

            <div class="card shadow-sm border-0 mb-5">
                <div class="card-header bg-white pt-3 border-bottom-0">
                    <h5 class="card-title text-primary fw-bold"><i class="fas fa-key me-2"></i>Đổi mật khẩu</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("DoiMatKhau", "KhachHang", FormMethod.Post))
                    {

                        <div class="mb-3">
                            <label class="form-label text-secondary">Mật khẩu hiện tại</label>
                            <input type="password" class="form-control" name="matKhauCu" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">Mật khẩu mới</label>
                            <input type="password" class="form-control" name="matKhauMoi" minlength="6" required>
                            <div class="form-text">Tối thiểu 6 ký tự.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary">Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control" name="xacNhanMatKhau" required>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-outline-primary">
                                Cập nhật mật khẩu
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border border-danger bg-light">
                <div class="card-body">
                    <h5 class="card-title text-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Vùng nguy hiểm</h5>
                    <p class="card-text text-muted">
                        Việc xóa tài khoản sẽ vô hiệu hóa quyền truy cập của bạn. Lịch sử đơn hàng có thể được lưu trữ ẩn danh. Hành động này không thể hoàn tác.
                    </p>

                    @using (Html.BeginForm("XoaTaiKhoan", "KhachHang", FormMethod.Post, new { onsubmit = "return confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa tài khoản này không? Hành động này không thể khôi phục!');" }))
                    {
                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-2"></i>Xóa tài khoản vĩnh viễn
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>