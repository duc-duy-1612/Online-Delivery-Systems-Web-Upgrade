@{
    ViewBag.Title = "Thanh toán chuyển khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .payment-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .payment-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .amount-text {
        color: #d32f2f;
        font-size: 2rem;
        font-weight: 800;
    }

    .qr-frame {
        background-color: #fff;
        padding: 15px;
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        display: inline-block;
        margin: 20px 0;
    }

    .bank-info {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        text-align: left;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card payment-card">
                <div class="payment-header">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-qrcode me-2"></i>Quét Mã Thanh Toán</h4>
                    <p class="mb-0 opacity-75">Đơn hàng: <strong>@ViewBag.MaDon</strong></p>
                </div>

                <div class="card-body text-center p-4">
                    <p class="text-muted mb-1">Tổng số tiền cần thanh toán</p>
                    <div class="amount-text mb-2">@String.Format("{0:N0} ₫", ViewBag.TongTien)</div>

                    <div class="qr-frame">
                        <img src="@ViewBag.QRCode" alt="QR Code Thanh Toán" class="img-fluid" style="max-width: 250px; height: auto;" />
                    </div>

                    <div class="bank-info">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <span class="fw-bold">MB Bank</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số tài khoản:</span>
                            <span class="fw-bold">0000 1234 5678</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <span class="fw-bold">ZFOOD COMPANY</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung CK:</span>
                            <span class="fw-bold text-primary">@ViewBag.MaDon</span>
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-circle me-2 fs-4"></i>
                        <div class="small text-start">
                            Sau khi chuyển khoản thành công, vui lòng bấm nút <strong>"Xác nhận đã thanh toán"</strong> bên dưới để hoàn tất.
                        </div>
                    </div>

                    @using (Html.BeginForm("XacNhanThanhToanQR", "KhachHang", FormMethod.Post))
                    {
                        @Html.Hidden("maDon", (string)ViewBag.MaDon)
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-2"></i> Xác nhận đã thanh toán
                            </button>
                            <a href="@Url.Action("DonHangCuaToi", "KhachHang")" class="btn btn-outline-secondary">
                                Để sau, xem đơn hàng
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />