@model ĐACN.KhachHang

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-info-circle me-2"></i> @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h4 class="card-title fw-bold text-primary"><i class="fas fa-user-circle me-2"></i>Thông tin cá nhân</h4>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("CapNhatHoSo", "KhachHang", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {

                        <div class="row">
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <div class="position-relative d-inline-block">
                                    <div class="avatar-preview mb-3">
                                        <img id="previewImg"
                                             src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/default-avatar.png" : Model.HinhAnh)"
                                             alt="Avatar"
                                             class="rounded-circle img-thumbnail shadow-sm"
                                             style="width: 150px; height: 150px; object-fit: cover;">
                                    </div>

                                    <label for="hinhAnhUpload" class="btn btn-sm btn-outline-primary rounded-pill">
                                        <i class="fas fa-camera me-1"></i> Đổi ảnh
                                    </label>
                                    <input type="file" name="hinhAnh" id="hinhAnhUpload" class="d-none" accept="image/*" onchange="previewFile(this)">
                                </div>
                                <div class="mt-2 text-muted small">
                                    Dung lượng tối đa 5MB<br>Định dạng: JPG, PNG
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary">Họ và tên</label>
                                    <input type="text" class="form-control form-control-lg" name="tenKH" value="@Model.TenKH" placeholder="Nhập họ tên của bạn" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary">Số điện thoại</label>
                                    <input type="text" class="form-control" name="sdt" value="@Model.SDT" placeholder="Số điện thoại liên hệ" pattern="[0-9]{10,11}" title="SĐT phải từ 10-11 số" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary">Địa chỉ giao hàng mặc định</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-map-marker-alt text-danger"></i></span>
                                        <textarea class="form-control" name="diaChi" rows="2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện...">@Model.DiaChi</textarea>
                                    </div>
                                    <div class="form-text text-muted">
                                        <small><i class="fas fa-info-circle"></i> Hệ thống sẽ tự động cập nhật tọa độ GPS khi bạn thay đổi địa chỉ này.</small>
                                    </div>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewFile(input) {
        var file = input.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function () {
                $("#previewImg").attr("src", reader.result);
            }
            reader.readAsDataURL(file);
        }
    }
</script>