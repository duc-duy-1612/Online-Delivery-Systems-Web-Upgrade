@model ĐACN.Shipper
@using System

@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_LayoutShipper.cshtml";

    var avatarSrc = !string.IsNullOrEmpty(Model.HinhAnh) ? Url.Content("~" + Model.HinhAnh) : null;
    var diemDanhGia = ViewBag.DiemDanhGia != null ? (double)ViewBag.DiemDanhGia : 0;
    var soSaoLamTron = ViewBag.SoSaoLamTron != null ? (int)ViewBag.SoSaoLamTron : 0;
    var soLanDanhGia = ViewBag.SoLanDanhGia != null ? (int)ViewBag.SoLanDanhGia : 0;
    var ratingText = diemDanhGia > 0 ? diemDanhGia.ToString("N1") : "Chưa có";
    var displayLabel = (!string.IsNullOrWhiteSpace(Model.TenShipper) ? Model.TenShipper : Model.TaiKhoan?.TenDangNhap ?? "?").Trim();
    var avatarInitial = displayLabel.Length > 0 ? displayLabel.Substring(0, 1).ToUpperInvariant() : "?";
    var tongThuNhap = ViewBag.TongThuNhap != null ? (decimal)ViewBag.TongThuNhap : 0;
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12 mb-4 pb-3 border-bottom">
            <span class="text-uppercase text-muted fw-bold" style="letter-spacing: 1px; font-size: 0.85rem;">HỒ SƠ CỦA BẠN</span>
            <h2 class="mb-0 fw-bold mt-1">Thông tin cá nhân</h2>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success" style="border-radius: 12px;">@TempData["Message"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100" style="border-radius: 16px; border: none;">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(avatarSrc))
                    {
                        <img src="@avatarSrc" alt="Avatar" class="rounded-circle shadow-sm mb-4" style="width:140px;height:140px;object-fit:cover;object-position:center;display:block;margin:0 auto;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light text-dark shadow-sm d-inline-flex justify-content-center align-items-center mb-4" style="width:140px;height:140px;font-size:3rem;font-weight:700;">
                            @avatarInitial
                        </div>
                    }
                    <h5 class="fw-bold mb-1">@(!string.IsNullOrWhiteSpace(Model.TenShipper) ? Model.TenShipper : "Chưa cập nhật")</h5>
                    <div class="text-muted small mb-4">Tài khoản: @(Model.TaiKhoan?.TenDangNhap)</div>
                    
                    <div class="p-3 bg-light" style="border-radius: 12px;">
                        <div class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">ĐIỂM ĐÁNH GIÁ</div>
                        <div class="fs-4 fw-bold text-dark mb-1">@ratingText / 5.0</div>
                        @if (soLanDanhGia > 0)
                        {
                            <small class="text-muted">Dựa trên @soLanDanhGia lượt đánh giá</small>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-8">
            <div class="card shadow-sm h-100" style="border-radius: 16px; border: none;">
                <div class="card-body p-4 p-md-5">
                    @using (Html.BeginForm("Profile", "Shipper", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row g-4" }))
                    {
                        <div class="col-12 mb-2">
                            <h6 class="text-uppercase text-muted fw-bold mb-0" style="letter-spacing: 1px;">THÔNG TIN LIÊN LẠC</h6>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Tên hiển thị</label>
                            <input class="form-control bg-light border-0 py-2" name="tenShipper" value="@Model.TenShipper" style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Số điện thoại</label>
                            <input class="form-control bg-light border-0 py-2" name="sdt" value="@Model.SDT" style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Biển số xe</label>
                            <input class="form-control bg-light border-0 py-2" name="bienSoXe" value="@Model.BienSoXe" style="border-radius: 8px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Tên đăng nhập</label>
                            <input class="form-control border-0 py-2" name="username" value="@(Model.TaiKhoan?.TenDangNhap)" style="border-radius: 8px; background-color: #f1f3f5;" readonly />
                            <small class="text-muted" style="font-size: 0.75rem;">Không thể thay đổi tên đăng nhập.</small>
                        </div>
                        
                        <div class="col-12 mt-4 mb-2">
                            <h6 class="text-uppercase text-muted fw-bold mb-0" style="letter-spacing: 1px;">ẢNH ĐẠI DIỆN & BẢO MẬT</h6>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Tải lên ảnh mới</label>
                            <input type="file" name="avatar" id="avatarInput" accept="image/*" class="form-control border bg-white" style="border-radius: 8px;" />
                            <div id="avatarPreview" class="mt-3 text-center" style="display:none;">
                                <img id="previewImg" src="#" alt="Preview" class="rounded-3 shadow-sm mb-2" style="max-width:120px;max-height:120px;object-fit:cover;" />
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" style="border-radius: 50px;" id="removeAvatarPreview">Hủy ảnh này</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">Mật khẩu mới</label>
                            <input class="form-control bg-light border-0 py-2" type="password" name="password" placeholder="Để trống nếu không muốn đổi" style="border-radius: 8px;" />
                        </div>

                        <div class="col-12 mt-5 text-end">
                            <button type="submit" class="btn btn-dark fw-bold px-5 py-2" style="border-radius: 50px;">LƯU THAY ĐỔI</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        var avatarInput = $('#avatarInput');
        var avatarPreview = $('#avatarPreview');
        var previewImg = $('#previewImg');
        var removeBtn = $('#removeAvatarPreview');

        avatarInput.on('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/bmp'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Chỉ chấp nhận file ảnh (JPG, PNG, GIF, BMP).');
                    avatarInput.val('');
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('Kích thước file không được vượt quá 5MB.');
                    avatarInput.val('');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.attr('src', e.target.result);
                    avatarPreview.show();
                };
                reader.readAsDataURL(file);
            } else {
                avatarPreview.hide();
            }
        });

        removeBtn.on('click', function() {
            avatarInput.val('');
            avatarPreview.hide();
            previewImg.attr('src', '#');
        });

        @if (!string.IsNullOrEmpty(avatarSrc))
        {
            <text>
            previewImg.attr('src', '@avatarSrc');
            avatarPreview.show();
            </text>
        }
    });
</script>