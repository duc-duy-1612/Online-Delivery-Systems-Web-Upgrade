@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #111827;">Tổng quan hệ thống</h2>
        <p class="text-muted mb-0">Theo dõi hoạt động và doanh thu của nền tảng.</p>
    </div>
    
    <div class="d-flex align-items-center gap-3">
        <form method="get" class="d-flex align-items-center bg-white border rounded-3 p-1">
            <select name="type" class="form-select border-0 shadow-none bg-transparent fw-medium text-dark" style="width: 140px; cursor: pointer;" onchange="this.form.submit()">
                <option value="Tháng" @(ViewBag.Type == "Tháng" ? "selected" : "")>Theo Tháng</option>
                <option value="Quý" @(ViewBag.Type == "Quý" ? "selected" : "")>Theo Quý</option>
            </select>
        </form>

        <form method="post" action="@Url.Action("ExportThongKe", "Admin")">
            <input type="hidden" name="format" value="excel" />
            <button type="submit" class="btn btn-dark btn-modern d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Xuất báo cáo
            </button>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="admin-card border-0 d-flex align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 56px; height: 56px; background-color: rgba(33, 150, 243, 0.1); color: #2196f3;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div>
                <div class="text-muted fw-bold mb-1" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Khách hàng</div>
                <div class="fs-4 fw-bold" style="color: #111827;">@ViewBag.KhachHang</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card border-0 d-flex align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 56px; height: 56px; background-color: rgba(255, 193, 7, 0.1); color: #ffb300;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </div>
            <div>
                <div class="text-muted fw-bold mb-1" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Nhà hàng đối tác</div>
                <div class="fs-4 fw-bold" style="color: #111827;">@ViewBag.NhaHang</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card border-0 d-flex align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 56px; height: 56px; background-color: rgba(76, 175, 80, 0.1); color: #4caf50;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            </div>
            <div>
                <div class="text-muted fw-bold mb-1" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Shipper (Tài xế)</div>
                <div class="fs-4 fw-bold" style="color: #111827;">@ViewBag.Shipper</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Chart: Doanh thu -->
    <div class="col-lg-8 mb-4">
        <div class="admin-card border-0 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0" style="color: #111827;">Tăng trưởng doanh thu</h5>
                <span class="badge bg-light text-dark border">@ViewBag.Type</span>
            </div>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="chartRevenue"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Chart: Phân bố người dùng -->
    <div class="col-lg-4 mb-4">
        <div class="admin-card border-0 h-100">
            <h5 class="fw-bold mb-4" style="color: #111827;">Cơ cấu người dùng</h5>
            <div style="position: relative; height: 260px; width: 100%; display: flex; justify-content: center;">
                <canvas id="chartUsers"></canvas>
            </div>
            <div class="mt-4 text-center text-muted" style="font-size: 0.85rem;">
                Dữ liệu phân bố tài khoản trên hệ thống
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart Config Defaults
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = '#9ca3af';

        // ===== Biểu đồ người dùng (Doughnut thay cho Bar để sang trọng hơn) =====
        const ctxUsers = document.getElementById('chartUsers').getContext('2d');
        const chartUsers = new Chart(ctxUsers, {
            type: 'doughnut',
            data: {
                labels: ["Khách hàng", "Chủ cửa hàng", "Shipper"],
                datasets: [{
                    data: [@ViewBag.KhachHang, @ViewBag.NhaHang, @ViewBag.Shipper],
                    backgroundColor: ['#3b82f6', '#f59e0b', '#10b981'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    }
                }
            }
        });

        // ===== Biểu đồ Doanh Thu =====
        const revenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DoanhThu));
        const chartType = "@ViewBag.Type";

        const labels = revenueData.map(item => {
            if (chartType === "Tháng") {
                return `Tháng ${item.Thang}`;
            } else {
                return `Quý ${item.Thang}`; 
            }
        });

        const values = revenueData.map(item => item.DoanhThu);
        const hoaHongValues = revenueData.map(item => item.HoaHong);

        // Tạo Gradient cho Line chart Doanh thu
        const ctxRevenue = document.getElementById('chartRevenue').getContext('2d');
        let gradient = ctxRevenue.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(59, 130, 246, 0.2)');   
        gradient.addColorStop(1, 'rgba(59, 130, 246, 0)');

        let gradientHoaHong = ctxRevenue.createLinearGradient(0, 0, 0, 400);
        gradientHoaHong.addColorStop(0, 'rgba(16, 185, 129, 0.2)');
        gradientHoaHong.addColorStop(1, 'rgba(16, 185, 129, 0)');

        const chartRevenue = new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                {
                    label: 'Doanh thu (VNĐ)',
                    data: values,
                    backgroundColor: gradient,
                    borderColor: '#3b82f6',
                    borderWidth: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#3b82f6',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4 // Làm cong đường đồ thị cho mượt
                },
                {
                    label: 'Hoa hồng 10% (VNĐ)',
                    data: hoaHongValues,
                    backgroundColor: gradientHoaHong,
                    borderColor: '#10b981',
                    borderWidth: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#10b981',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        backgroundColor: '#111827',
                        padding: 12,
                        titleFont: { size: 13, weight: 'normal' },
                        bodyFont: { size: 14, weight: 'bold' },
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: { 
                    y: { 
                        beginAtZero: true,
                        grid: {
                            color: '#f3f4f6',
                            drawBorder: false
                        },
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) {
                                    return (value / 1000000) + 'M';
                                }
                                return value;
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        }
                    }
                }
            }
        });
    </script>
}