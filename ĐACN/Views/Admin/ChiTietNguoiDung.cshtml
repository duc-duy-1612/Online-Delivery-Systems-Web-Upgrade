@model ĐACN.KhachHang
@{
    ViewBag.Title = "Chi tiết người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool isEdit = ViewBag.EditMode == true; // flag chỉnh sửa
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #111827;">Hồ sơ khách hàng</h2>
        <p class="text-muted mb-0">Xem và cập nhật trạng thái người dùng: <span class="text-dark fw-medium">#@Model.MaKH</span></p>
    </div>
    <a href="@Url.Action("DanhSachNguoiDung", "Admin")" class="btn btn-light fw-medium px-4" style="border-radius: 8px; border: 1px solid #e5e7eb;">
        Trở lại danh sách
    </a>
</div>

<div class="row">
    @using (Html.BeginForm("SuaNguoiDung", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "row w-100 m-0" }))
    {
        @Html.HiddenFor(m => m.MaKH)

        <!-- Cột bên trái: Ảnh đại diện placeholder & Thông tin chung -->
        <div class="col-lg-4 mb-4">
            <div class="admin-card border-0 h-100 text-center">
                <div class="position-relative d-inline-block mb-3 mt-3">
                    <div class="rounded-circle d-flex justify-content-center align-items-center text-white" 
                         style="width: 140px; height: 140px; background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); font-size: 3rem; font-weight: bold; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border: 4px solid #fff;">
                        @(Model.TenKH != null && Model.TenKH.Length > 0 ? Model.TenKH.Substring(0, 1).ToUpper() : "U")
                    </div>
                </div>

                <h4 class="fw-bold mt-2 mb-1" style="color: #111827;">@Model.TenKH</h4>
                <div class="text-muted small mb-3">Tham gia: @(Model.TaiKhoan?.TenDangNhap ?? "N/A")</div>

                <div class="bg-light rounded p-3 text-start">
                    <div class="mb-2">
                        <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase;">Vai trò hệ thống</div>
                        <div class="fw-medium text-dark mt-1">@(Model.TaiKhoan != null ? Model.TaiKhoan.VaiTro : "Không xác định")</div>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size: 0.75rem; text-transform: uppercase;">Trạng thái tài khoản</div>
                        @if (Model.TaiKhoan?.TrangThai == true)
                        {
                            <div class="fw-bold text-success mt-1">Đang hoạt động</div>
                        }
                        else
                        {
                            <div class="fw-bold text-danger mt-1">Đã bị khóa</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Form chi tiết -->
        <div class="col-lg-8 mb-4">
            <div class="admin-card border-0 h-100">
                <h5 class="fw-bold border-bottom pb-3 mb-4" style="color: #111827;">Thông tin liên hệ</h5>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Tên khách hàng</label>
                        <div class="p-3 bg-light rounded-3 text-dark fw-medium">@Model.TenKH</div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Số điện thoại</label>
                        <div class="p-3 bg-light rounded-3 text-dark fw-medium">@Model.SDT</div>
                    </div>
                    
                    <div class="col-md-12">
                        <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Địa chỉ thường trú</label>
                        <div class="p-3 bg-light rounded-3 text-dark fw-medium">@Model.DiaChi</div>
                    </div>
                </div>

                <h5 class="fw-bold border-bottom pb-3 mb-4" style="color: #111827; margin-top: 2rem;">Cài đặt bảo mật</h5>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Tên đăng nhập</label>
                        <div class="p-3 bg-light rounded-3 text-dark fw-medium">@(Model.TaiKhoan != null ? Model.TaiKhoan.TenDangNhap : "Chưa có tài khoản")</div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Mật khẩu</label>
                        <div class="p-3 bg-light rounded-3 text-dark fw-medium">@(Model.TaiKhoan != null ? "••••••••" : "Chưa có")</div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="col-md-6">
                            <label class="text-muted fw-bold mb-2" style="font-size: 0.8rem; text-transform: uppercase;">Khóa / Mở tài khoản</label>
                            <select name="TrangThai" class="form-select bg-light border-0 shadow-none p-3 rounded-3">
                                <option value="true" @(Model.TaiKhoan?.TrangThai == true ? "selected" : "")>Hoạt động</option>
                                <option value="false" @(Model.TaiKhoan?.TrangThai == false ? "selected" : "")>Khóa tài khoản</option>
                            </select>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                    @if (!isEdit)
                    {
                        <a href="@Url.Action("ChiTietNguoiDung", "Admin", new { id = Model.MaKH, edit = true })" class="btn btn-dark btn-modern px-4">
                            Đổi trạng thái tài khoản
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ChiTietNguoiDung", "Admin", new { id = Model.MaKH })" class="btn btn-light fw-medium px-4" style="border-radius: 8px; border: 1px solid #e5e7eb;">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-success btn-modern px-4">
                            Xác nhận lưu
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mt-3 text-center fw-bold" style="border-radius: 8px; background-color: #d1fae5; color: #065f46;">
        @TempData["Message"]
    </div>
}