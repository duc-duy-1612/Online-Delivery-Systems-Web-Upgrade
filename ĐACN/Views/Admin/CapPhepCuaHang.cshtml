@model IEnumerable<ĐACN.NhaHang>
@{
    ViewBag.Title = "Cấp phép cửa hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #111827;">Duyệt đăng ký nhà hàng</h2>
        <p class="text-muted mb-0">Quản lý và xét duyệt các yêu cầu mở gian hàng mới trên hệ thống.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 8px; background-color: #d1fae5; color: #065f46;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4" style="border-radius: 8px; background-color: #fee2e2; color: #991b1b;">
        @TempData["Error"]
    </div>
}

<div class="admin-card border-0 p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background-color: #f9fafb;">
                <tr>
                    <th class="text-muted fw-bold border-bottom-0 py-3 ps-4" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Mã</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Hình ảnh</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Thông tin nhà hàng</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Tài khoản</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3 pe-4 text-end" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Xét duyệt</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted text-center py-5">Không có yêu cầu đăng ký nhà hàng nào đang chờ.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="border-bottom" style="transition: all 0.2s ease;">
                            <td class="py-3 ps-4 text-muted fw-medium">#@item.MaNH</td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <img src="@Url.Content("~/images/nhahang/" + item.HinhAnh)" alt="@item.TenNH" style="width: 56px; height: 56px; object-fit: cover; border-radius: 8px;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex justify-content-center align-items-center text-muted" style="width: 56px; height: 56px; border-radius: 8px; font-size: 0.8rem;">Trống</div>
                                }
                            </td>
                            <td class="py-3">
                                <div class="fw-bold" style="color: #111827; font-size: 1.05rem;">@item.TenNH</div>
                                <div class="text-muted small mb-1"><span class="fw-medium text-dark">SĐT:</span> @item.SDT</div>
                                <div class="text-muted small text-truncate" style="max-width: 250px;"><span class="fw-medium text-dark">ĐC:</span> @item.DiaChi</div>
                            </td>
                            <td class="py-3">
                                <div class="text-dark fw-medium">@(item.TaiKhoan?.TenDangNhap ?? "N/A")</div>
                                <span class="badge bg-warning bg-opacity-10 text-warning fw-normal px-2 py-1 mt-1" style="border-radius: 4px;">Chờ duyệt</span>
                            </td>
                            <td class="py-3 pe-4 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="@Url.Action("ChiTietNhaHang", "Admin", new { id = item.MaNH })" class="btn btn-sm btn-light fw-medium px-3" style="border-radius: 6px;">
                                        Chi tiết
                                    </a>
                                    <form action="@Url.Action("TuChoi", "Admin")" method="post">
                                        <input type="hidden" name="id" value="@item.MaNH" />
                                        <button type="submit" class="btn btn-sm fw-medium px-3 text-danger" style="background-color: #fee2e2; border-radius: 6px; border: none;">
                                            Từ chối
                                        </button>
                                    </form>
                                    <form action="@Url.Action("ChapNhan", "Admin")" method="post">
                                        <input type="hidden" name="id" value="@item.MaNH" />
                                        <button type="submit" class="btn btn-sm fw-medium px-3 text-white" style="background-color: #10b981; border-radius: 6px; border: none;">
                                            Duyệt ngay
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>