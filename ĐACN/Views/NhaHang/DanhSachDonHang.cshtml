@model IEnumerable<ĐACN.Models.DonHangListViewModel>

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_LayoutNhaHang.cshtml";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white pt-4 pb-3 border-bottom-0">
        <h4 class="mb-3 fw-bold text-dark"><i class="bi bi-receipt me-2"></i> Danh sách đơn hàng</h4>

        <form method="get" action="@Url.Action("DanhSachDonHang", "NhaHang")" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold">TỪ NGÀY</label>
                <input type="date" name="tuNgay" class="form-control bg-light" value="@ViewBag.TuNgay" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold">ĐẾN NGÀY</label>
                <input type="date" name="denNgay" class="form-control bg-light" value="@ViewBag.DenNgay" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 btn-action" style="background: linear-gradient(135deg, #f2994a, #f2c94c); border: none;">
                    <i class="bi bi-search"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Shipper</th>
                    <th class="text-center pe-4" style="width: 200px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-black-50"></i>
                            Không có đơn hàng nào
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var don in Model)
                    {
                        <tr>
                            <td class="order-ma-don ps-4 text-primary fw-bold">@don.MaDon</td>
                            <td class="order-khach-hang fw-bold text-dark">@don.TenKhachHang</td>
                            <td class="order-thoi-gian text-muted">@(don.ThoiGianDat?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td class="order-tong-tien fw-bold text-success">@string.Format("{0:N0} đ", don.TongTien)</td>
                            <td class="order-trang-thai">
                                @if (don.TrangThai == "True" || don.TrangThai == "Hoàn thành")
                                {
                                    <span class="badge" style="background: linear-gradient(135deg, #11998e, #38ef7d); border-radius: 50px; padding: 6px 12px;">Hoàn thành</span>
                                }
                                else if (don.TrangThai == "Đang lấy món" || don.TrangThai == "Đang giao")
                                {
                                    <span class="badge" style="background: linear-gradient(135deg, #f2994a, #f2c94c); border-radius: 50px; padding: 6px 12px;">@don.TrangThai</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border" style="border-radius: 50px; padding: 6px 12px;">@(don.TrangThai ?? "Đang xử lý")</span>
                                }
                            </td>
                            <td class="order-shipper text-muted">@(don.TenShipper ?? "Chưa có")</td>
                            <td class="text-center pe-4">
                                <a href="@Url.Action("ChiTietDonHang", "NhaHang", new { id = don.MaDon })"
                                   class="btn btn-sm btn-outline-info btn-action me-1">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                @if (don.TrangThai != "True" && don.TrangThai != "Hoàn thành" && string.IsNullOrEmpty(don.TenShipper))
                                {
                                    using (Html.BeginForm("CapNhatLamXong", "NhaHang", FormMethod.Post, new { @class = "d-inline", id = "form_lamxong_" + don.MaDon }))
                                    {
                                        <input type="hidden" name="maDon" value="@don.MaDon" />
                                        <button type="button" class="btn btn-sm btn-outline-success btn-action"
                                                onclick="confirmLamXong('@don.MaDon')">
                                            <i class="bi bi-check2-circle"></i> Xong
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {

        var refreshIntervalMs = 15000;
        var isRefreshing = false;
        var refreshIntervalId = null;

        function updateOrderList() {
            if (isRefreshing) return;
            isRefreshing = true;


            var tuNgay = $('input[name="tuNgay"]').val();
            var denNgay = $('input[name="denNgay"]').val();

            $.ajax({
                url: '@Url.Action("GetDanhSachDonHangUpdate", "NhaHang")',
                type: 'GET',
                data: {
                    tuNgay: tuNgay,
                    denNgay: denNgay
                },
                success: function (response) {
                    if (response.success && response.orders) {
                        var tbody = $('table tbody');


                        var hasChanges = false;


                        response.orders.forEach(function (order) {
                            var row = tbody.find('tr').filter(function () {
                                return $(this).find('.order-ma-don').text() === order.MaDon;
                            });

                            if (row.length > 0) {

                                var currentStatus = row.find('.order-trang-thai .badge').text().trim();
                                var newStatus = order.TrangThaiDisplay;

                                var currentShipper = row.find('.order-shipper').text().trim();
                                var newShipper = order.TenShipper || 'Chưa có';

                                if (currentStatus !== newStatus || currentShipper !== newShipper) {
                                    hasChanges = true;


                                    var badge = row.find('.order-trang-thai .badge');
                                    badge.removeClass('bg-success bg-warning text-dark');
                                    badge.addClass(order.TrangThaiClass);
                                    badge.text(newStatus);


                                    row.find('.order-shipper').text(newShipper);


                                    row.css('background-color', '#fff3cd');
                                    setTimeout(function () {
                                        row.css('background-color', '');
                                    }, 2000);
                                }
                            }
                        });


                        if (hasChanges) {
                            console.log('Đã cập nhật trạng thái đơn hàng');
                        }
                    }
                    isRefreshing = false;
                },
                error: function () {
                    isRefreshing = false;
                    console.error('Lỗi khi cập nhật danh sách đơn hàng');
                }
            });
        }


        refreshIntervalId = setInterval(updateOrderList, refreshIntervalMs);


        $(window).on('beforeunload', function () {
            if (refreshIntervalId !== null) {
                clearInterval(refreshIntervalId);
            }
        });
    });

    function confirmLamXong(maDon) {
        Swal.fire({
            title: 'Xác nhận đơn hàng',
            text: 'Đơn hàng ' + maDon + ' đã làm xong và sẵn sàng cho shipper lấy?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đã xong',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('form_lamxong_' + maDon).submit();
            }
        });
    }
</script>