@{
    ViewBag.Title = "Thống kê doanh thu & đơn hàng";
    Layout = "~/Views/Shared/_LayoutNhaHang.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-3">
            <select class="form-select" id="timeRangeFilter" onchange="filterThongKe()">
                <option value="Ngày" @(ViewBag.CurrentTimeRange == "Ngày" ? "selected" : "")>Ngày</option>
                <option value="Tháng" @(ViewBag.CurrentTimeRange == "Tháng" || string.IsNullOrEmpty(ViewBag.CurrentTimeRange as string) ? "selected" : "")>Tháng</option>
                <option value="Quý" @(ViewBag.CurrentTimeRange == "Quý" ? "selected" : "")>Quý</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" id="statTypeFilter" onchange="filterThongKe()">
                <option value="Thống kê doanh thu" @(ViewBag.CurrentStatType == "Thống kê doanh thu" || string.IsNullOrEmpty(ViewBag.CurrentStatType as string) ? "selected" : "")>Thống kê doanh thu</option>
                <option value="Thống kê đơn hàng" @(ViewBag.CurrentStatType == "Thống kê đơn hàng" ? "selected" : "")>Thống kê đơn hàng</option>
            </select>
        </div>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted mb-0"><i class="bi bi-pie-chart-fill me-2" style="color: #f2994a;"></i> Biểu đồ doanh thu theo loại món ăn</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartDoanhThuTheoLoai"></canvas>
                </div>
            </div>
        </div>


        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted mb-0"><i class="bi bi-graph-up-arrow me-2" style="color: #11998e;"></i> Doanh thu theo thời gian</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartDoanhThu"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted mb-0"><i class="bi bi-diagram-3-fill me-2 text-warning"></i> Tỉ lệ trạng thái đơn hàng</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartTrangThaiDonHang"></canvas>
                </div>
            </div>
        </div>


        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 pt-4 pb-3">
                    <h6 class="fw-bold text-muted mb-0">
                        <i class="bi bi-star-fill text-warning me-2"></i> Món ăn bán chạy nhất
                    </h6>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên món</th>
                                <th>Giá (VNĐ)</th>
                                <th>Tổng số lượng bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TopSanPham != null && ((IEnumerable<dynamic>)ViewBag.TopSanPham).Any())
                            {
                                @* Lỗi: Bỏ ký tự '@' thừa khỏi dòng @foreach *@
                                foreach (var item in (IEnumerable<dynamic>)ViewBag.TopSanPham)
                                {
                                    <tr>
                                        <td>@item.TenMon</td>
                                        <td>@String.Format("{0:N0}", item.Gia)</td>
                                        <td>@item.SoLuongBan</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <script>
        // Đăng ký plugin hiển thị label cho tất cả các biểu đồ
        Chart.register(ChartDataLabels);

        // Cấu hình chung cho data labels trên biểu đồ tròn
        const pieDatalabelsConfig = {
            formatter: (value, ctx) => {
                if (value === 0) return '';
                let sum = 0;
                let dataArr = ctx.chart.data.datasets[0].data;
                dataArr.map(data => {
                    sum += parseFloat(data);
                });
                if (sum === 0) return '';
                let percentage = (value * 100 / sum).toFixed(1) + "%";
                return percentage;
            },
            color: '#fff',
            font: {
                weight: 'bold',
                size: 14
            },
            textStrokeColor: 'rgba(0,0,0,0.5)',
            textStrokeWidth: 2
        };

        new Chart(document.getElementById("chartDoanhThuTheoLoai"), {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Encode(ViewBag.LabelsLoai)),
                datasets: [{
                    data: @Html.Raw(Json.Encode(ViewBag.DataDoanhThuLoai)),
                    backgroundColor: ['#0d6efd', '#ffc107', '#28a745', '#dc3545', '#20c997']
                }]
            },
            options: {
                plugins: {
                    datalabels: pieDatalabelsConfig
                }
            }
        });


        new Chart(document.getElementById("chartDoanhThu"), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Encode(ViewBag.LabelsThoiGian)),
                datasets: [{
                    label: @Html.Raw(Json.Encode(ViewBag.ChartLabel ?? "Doanh thu (VNĐ)")),
                    data: @Html.Raw(Json.Encode(ViewBag.DataDoanhThu)),
                    backgroundColor: '#0dcaf0'
                }]
            },
            options: {
                plugins: {
                    datalabels: {
                        display: false // Không hiển thị % trên biểu đồ cột
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });


        new Chart(document.getElementById("chartTrangThaiDonHang"), {
            type: 'pie',
            data: {
                labels: ['Đang xử lý', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    data: @Html.Raw(Json.Encode(ViewBag.DataTrangThaiDonHang)),
                    backgroundColor: ['#ffc107', '#28a745', '#dc3545']
                }]
            },
            options: {
                plugins: {
                    datalabels: pieDatalabelsConfig
                }
            }
        });

        function filterThongKe() {
            var timeRange = document.getElementById("timeRangeFilter").value;
            var statType = document.getElementById("statTypeFilter").value;
            window.location.href = '@Url.Action("ThongKe", "NhaHang")' + '?timeRange=' + encodeURIComponent(timeRange) + '&statType=' + encodeURIComponent(statType);
        }
    </script>
}