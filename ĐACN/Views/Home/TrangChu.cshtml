@model ĐACN.Models.TrangChuViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang Chủ";
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #fff;
        color: #333;
    }

    .banner {
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=2070&auto=format&fit=crop');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        height: 450px;
        border-radius: 0 0 30px 30px;
        box-shadow: var(--soft-shadow);
    }

    .banner-overlay {
        background: rgba(0, 0, 0, 0.6);
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .banner-content h1 {
        font-size: 3.2rem;
        font-weight: 700;
        color: #fff;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    .banner-content p {
        font-size: 1.2rem;
        margin-top: 10px;
        color: #fff;
    }

    .search-bar {
        display: flex;
        justify-content: center;
        gap: 10px;
        width: 80%;
        max-width: 700px;
        margin: 0 auto;
    }

        .search-bar input {
            flex: 1;
            padding: 15px 25px;
            border-radius: 50px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            font-size: 1.1rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }
        
        .search-bar input:focus {
            background: #fff;
            border-color: #ff4b2b;
            outline: none;
            box-shadow: 0 10px 40px rgba(255,75,43,0.2);
        }
        
        .search-bar button {
            border-radius: 50px;
            padding: 0 35px;
            font-weight: bold;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            border: none;
            color: white;
            box-shadow: 0 4px 15px rgba(255,75,43,0.4);
            transition: all 0.3s ease;
        }
        
        .search-bar button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255,75,43,0.6);
        }
        
        /* Live Search Dropdown */
        .search-container {
            position: relative;
            width: 100%;
        }
        .live-search-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background: white;
            border-radius: 15px;
            margin-top: 10px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            z-index: 1000;
            max-height: 400px;
            overflow-y: auto;
            display: none;
            text-align: left;
        }
        .live-search-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            border-bottom: 1px solid #f1f1f1;
            text-decoration: none;
            color: #333;
            transition: background 0.2s;
        }
        .live-search-item:hover {
            background: #f8f9fa;
            color: #ff4b2b;
        }
        .live-search-item img {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            object-fit: cover;
            margin-right: 15px;
        }
        .live-search-item-info h6 {
            margin: 0 0 5px 0;
            font-weight: bold;
        }
        .live-search-item-info p {
            margin: 0;
            font-size: 0.85rem;
            color: #666;
        }
        .live-search-empty {
            padding: 20px;
            text-align: center;
            color: #666;
        }
        
        /* Quick Filters */
        .quick-filters {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .filter-pill {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: white;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s;
            cursor: pointer;
        }
        .filter-pill:hover {
            background: white;
            color: #ff4b2b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .section-title {
        font-weight: 700;
        margin-bottom: 25px;
    }

    .category-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 15px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(0,0,0,0.03);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        cursor: pointer;
        display: block;
        text-decoration: none;
    }

    .category-card:hover {
        transform: translateY(-5px);
        background: #fff;
        box-shadow: 0 10px 25px rgba(255,75,43,0.15);
        border-color: rgba(255,75,43,0.2);
    }
    
    .category-card span {
        font-weight: 600;
        color: #333;
        transition: color 0.3s;
    }
    .category-card:hover span {
        color: #ff4b2b;
    }

    .category-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        margin-bottom: 10px;
        transition: transform 0.3s ease;
    }
    .category-card:hover .category-img {
        transform: scale(1.1);
    }

    .feedback-card {
        background: #fff8f8;
        border-radius: 10px;
        padding: 20px;
        font-style: italic;
    }

    .footer {
        background: #222;
        color: #ccc;
        padding: 25px 0;
    }
    
    /* Skeleton Loading CSS */
    .skeleton-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .skeleton-img {
        width: 100%;
        height: 160px;
        background: #e0e0e0;
        animation: pulse 1.5s infinite ease-in-out;
    }
    .skeleton-body {
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .skeleton-text {
        height: 15px;
        background: #e0e0e0;
        border-radius: 4px;
        animation: pulse 1.5s infinite ease-in-out;
    }
    .skeleton-text.w-75 { width: 75%; height: 20px; }
    .skeleton-text.w-50 { width: 50%; }
    .skeleton-text.w-100 { width: 100%; }
    @@keyframes pulse {
        0% { background-color: #e0e0e0; }
        50% { background-color: #f5f5f5; }
        100% { background-color: #e0e0e0; }
    }
</style>

<section class="banner">
    <div class="banner-overlay">
        <div class="banner-content text-center">
            <h1>Đặt món nhanh – Giao tận nơi</h1>
            <p>Khám phá hàng trăm nhà hàng, quán ăn yêu thích quanh bạn!</p>


            <form class="search-bar mt-4" method="get" action="@Url.Action("TrangChu", "Home")">
                <div class="search-container d-flex">
                    <input type="text"
                           id="searchInput"
                           name="search"
                           class="form-control"
                           placeholder="Nhập món ăn, nhà hàng..."
                           value="@ViewBag.Search" autocomplete="off" />

                    <button class="btn btn-primary-custom ms-2" type="submit"><i class="fa-solid fa-magnifying-glass me-2"></i>Tìm kiếm</button>
                    
                    <!-- Dropdown cho kết quả Live Search -->
                    <div id="liveSearchDropdown" class="live-search-dropdown">
                        <!-- Items sẽ được render qua JS -->
                    </div>
                </div>
            </form>
            
            <div class="quick-filters">
                <a href="@Url.Action("TrangChu", "Home", new { sort = "gantoi" })" class="filter-pill"><i class="fas fa-map-marker-alt me-2 text-danger"></i>Gần tôi nhất</a>
                <a href="@Url.Action("TrangChu", "Home", new { sort = "rating" })" class="filter-pill"><i class="fas fa-star me-2 text-warning"></i>Đánh giá 5 sao</a>
                <a href="@Url.Action("TrangChu", "Home", new { sort = "banchay" })" class="filter-pill"><i class="fas fa-fire me-2 text-danger"></i>Đang bán chạy</a>
            </div>

        </div>
    </div>
</section>

<section class="container mt-5">
    <h2 class="section-title">Danh mục phổ biến</h2>
    @Html.Partial("_DanhMucPartial", Model.DanhMuc)
</section>

<section class="container mt-5" id="recommended-section" style="display: none;">
    <h2 class="section-title" style="color: #ff4b2b;">Dành riêng cho bạn</h2>
    <p class="text-muted" style="margin-top: -15px; margin-bottom: 25px;">Gợi ý từ thói quen đặt món gần đây của bạn</p>
    <div id="recommended-container">
        <!-- Dữ liệu sẽ load qua AJAX -->
    </div>
</section>

<section id="result-section" class="container mt-5">
    <h2 class="section-title">Nhà hàng nổi bật</h2>
    <div id="nhahang-container">
        <!-- Skeleton Loading -->
        <div class="row g-4">
            @for (int i = 0; i < 8; i++)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <div class="skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="skeleton-body">
                            <div class="skeleton-text w-75"></div>
                            <div class="skeleton-text w-100"></div>
                            <div class="skeleton-text w-50"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="feedback mt-5">
    <div class="container text-center">
        <h2 class="section-title">Khách hàng nói gì về chúng tôi</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card feedback-card">
                    <p>“Giao hàng cực nhanh, đồ ăn còn nóng hổi! Rất hài lòng”</p>
                    <h6>- Minh Anh</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feedback-card">
                    <p>“Món ăn đa dạng, tìm quán dễ dàng, thanh toán tiện lợi”</p>
                    <h6>- Đức Huy</h6>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feedback-card">
                    <p>“App thân thiện, đặt hàng chưa bao giờ nhanh như vậy”</p>
                    <h6>- Thuỷ Tiên</h6>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="footer mt-5">
    <div class="container text-center">
        <p>© 2025 ZFood Delivery. All rights reserved.</p>
        <p>Hotline: 1900 9999 | Email: support@zfood.vn</p>
    </div>
</footer>

@if (Session["TaiKhoan"] != null && (Session["TaiKhoan"] as ĐACN.TaiKhoan)?.VaiTro == "KhachHang")
{
    @Html.Partial("~/Views/KhachHang/_DanhGiaShipperModal.cshtml")
    @Html.Partial("~/Views/KhachHang/_DanhGiaNhaHangModal.cshtml")
    @Html.Partial("~/Views/KhachHang/_ThongBaoPartial.cshtml")
}

@section scripts{
    <script>
        $(document).ready(function () {
            const isKhachHang = @((Session["TaiKhoan"] != null && (Session["TaiKhoan"] as ĐACN.TaiKhoan)?.VaiTro == "KhachHang").ToString().ToLower());

            // Load Trang Chu Data via AJAX
            var searchParams = new URLSearchParams(window.location.search);
            var sort = searchParams.get('sort') || 'default';
            var search = searchParams.get('search') || '';

            $.ajax({
                url: '@Url.Action("GetHomeData", "Home")',
                type: 'GET',
                data: { sort: sort, search: search },
                success: function (res) {
                    if (res.recommended && res.recommended.trim() !== "") {
                        $('#recommended-container').html(res.recommended);
                        $('#recommended-section').fadeIn();
                    }
                    
                    if (res.nhahang && res.nhahang.trim() !== "") {
                        $('#nhahang-container').html(res.nhahang);
                    } else {
                        $('#nhahang-container').html('<div class="alert alert-warning">Không tìm thấy nhà hàng nào.</div>');
                    }
                },
                error: function () {
                    $('#nhahang-container').html('<div class="alert alert-danger">Đã xảy ra lỗi khi tải dữ liệu nhà hàng.</div>');
                }
            });

            try {
                const params = new URLSearchParams(window.location.search);
                const searchParam = params.get('search');
                const hasSearch = searchParam && searchParam.trim() !== "";

                if (hasSearch) {
                    window.addEventListener('load', function () {
                        setTimeout(function () {
                            var $target = $("#result-section");
                            if ($target.length) {
                                $('html, body').animate({
                                    scrollTop: $target.offset().top - 50
                                }, 600);
                            }
                        }, 150);
                    });
                }
            } catch (e) {
                console.error(e);
            }
        });
    </script>
}