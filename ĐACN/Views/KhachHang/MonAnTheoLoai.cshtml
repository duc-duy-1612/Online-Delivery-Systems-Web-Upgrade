@model ĐACN.Models.MonAnTheoLoaiViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.LoaiMonAn.TenLoai;
}

<style>
    body {
        background-color: #f8f9fa;
    }
    .restaurant-card {
        border: none;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        position: relative;
    }
    .restaurant-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.1);
        color: inherit;
    }
    .restaurant-img-wrapper {
        position: relative;
        padding-top: 65%;
        overflow: hidden;
    }
    .restaurant-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .restaurant-card:hover .restaurant-img {
        transform: scale(1.08);
    }
    .restaurant-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
        z-index: 1;
    }
    .restaurant-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(255, 255, 255, 0.95);
        color: #ff9800;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        backdrop-filter: blur(4px);
    }
    .restaurant-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .restaurant-title {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        color: #2b2b2b;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .restaurant-address {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .restaurant-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        font-size: 0.85rem;
        color: #495057;
        font-weight: 600;
    }
    .stat-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .stat-item i {
        color: #0d6efd;
    }
    .page-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>

<div class="page-header text-center">
    <h2 class="fw-bold mb-2">Thế Giới @Model.LoaiMonAn.TenLoai</h2>
    <p class="opacity-75 mb-0">Khám phá các nhà hàng có món @Model.LoaiMonAn.TenLoai ngon nhất</p>
</div>

<div class="container mb-5">
    @if (Model.NhaHang == null || !Model.NhaHang.Any())
    {
        <div class="text-center py-5">
            <img src="~/Content/Images/empty-cart.png" alt="Empty" style="width: 150px; opacity: 0.5;" class="mb-4" onerror="this.src='https://cdn-icons-png.flaticon.com/512/743/743354.png'" />
            <h5 class="text-muted fw-bold">Chưa có nhà hàng nào bán món ăn này.</h5>
            <p class="text-muted mb-4">Hãy quay lại sau hoặc khám phá các danh mục khác nhé!</p>
            <a href="@Url.Action("TrangChu", "Home")" class="btn btn-primary rounded-pill px-4">Về trang chủ</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var nh in Model.NhaHang)
            {
                <div class="col">
                    <a href="@Url.Action("XemMenu", "KhachHang", new { id = nh.MaNH })" class="restaurant-card">
                        <div class="restaurant-img-wrapper">
                            <img src="~/images/nhahang/@nh.HinhAnh" alt="@nh.TenNH" class="restaurant-img" onerror="this.onerror=null; this.src='/images/nhahang/comtam_saigon.jpg'" />
                            <div class="restaurant-overlay"></div>
                            @if (nh.Rating > 0)
                            {
                                <div class="restaurant-badge">
                                    <i class="fas fa-star text-warning me-1"></i> @nh.Rating
                                </div>
                            }
                        </div>
                        <div class="restaurant-body">
                            <h5 class="restaurant-title">@nh.TenNH</h5>
                            <p class="restaurant-address"><i class="fas fa-map-marker-alt text-danger me-1"></i> @nh.DiaChi</p>
                            <div class="restaurant-meta pt-2 border-top">
                                <div class="stat-item">
                                    <i class="fas fa-shopping-bag text-success"></i> @nh.TongLuotMua đã bán
                                </div>
                                <div class="stat-item text-primary">
                                    Xem menu <i class="fas fa-arrow-right ms-1"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>